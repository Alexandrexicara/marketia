# MarketIA API — copie para .env local ou configure no Render
PORT=4000
# Neon PostgreSQL (use a connection string com SSL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_SSL=true
# URL(s) do frontend, separadas por vírgula. Em produção, informe o domínio Netlify.
ALLOWED_ORIGINS=http://localhost:5173
